OPENAI_API_KEY=
AUTOMATION_DRY_RUN=true
AUTOMATION_ENV=development

# Phase G Task G5.1 — Telegram Bot API notification provider(선택 사항). 둘 다 설정해야
# provider가 CONFIGURED로 인식되며(notification-provider-telegram.ts), 비어 있으면 실제
# 전송 없이 NOT_CONFIGURED로만 동작한다(Core run을 깨뜨리지 않음).
AUTODEV_TELEGRAM_BOT_TOKEN=
AUTODEV_TELEGRAM_CHAT_ID=

# Phase G Task G6 — Telegram Mobile Approval callback 발신자 검증(선택 사항, telegram-
# callback-client.ts). 지정하지 않으면 AUTODEV_TELEGRAM_CHAT_ID만으로 발신자를 판정한다.
# 지정하면 callback_query.from.id까지 함께 검증해 chat 안의 특정 사용자로 승인 권한을
# 좁힌다.
AUTODEV_TELEGRAM_USER_ID=

DEV_SUPABASE_URL=
DEV_SUPABASE_PUBLISHABLE_KEY=
DEV_SUPABASE_SECRET_KEY=
DEV_SUPABASE_PROJECT_REF=
